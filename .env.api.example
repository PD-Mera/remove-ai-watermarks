# Copy to .env.api and set a private random key before deployment.
API_KEY=replace-with-your-private-random-key
API_BIND_HOST=127.0.0.1
API_PORT=8000
WATERMARK_EXTRAS=video
WATERMARK_BACKEND=cv2
MAX_UPLOAD_MB=512
MAX_CONCURRENT_JOBS=1
PROCESS_TIMEOUT_SECONDS=1800
UPLOAD_IDLE_TIMEOUT_SECONDS=60
MAX_IMAGE_PIXELS=40000000
MAX_VIDEO_SECONDS=300
MAX_VIDEO_PIXELS=8294400
MEMORY_LIMIT=8g
CPU_LIMIT=4.0
